{
  "name": "dsh-flowspace-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "start": "node scripts/launcher.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p packages/flowspace/tsconfig.host.json --noEmit && tsc -p packages/flowspace/tsconfig.client.json --noEmit",
    "test": "tsx --test packages/flowspace/test/*.test.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "test:real": "tsx scripts/real-smoke.ts",
    "dev": "node --expose-internals scripts/dev.mjs",
    "dev:mock": "node --expose-internals scripts/dev.mjs --mock",
    "sandbox": "node scripts/sandbox.mjs",
    "sandbox:plugin": "node scripts/sandbox.mjs plugin",
    "sandbox:sync-auth": "node scripts/sandbox.mjs sync-auth",
    "sandbox:reset": "node scripts/sandbox.mjs reset",
    "sandbox:dsh": "node scripts/sandbox.mjs dsh",
    "pack:plugin": "pnpm build && pnpm --dir packages/flowspace pack --pack-destination ../../artifacts",
    "install:market": "node scripts/install.mjs --profile web --github",
    "test:integration": "tsx scripts/integration.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
